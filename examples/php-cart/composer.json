{
    "name": "souther-lang/php-cart",
    "description": "The raoh-souther cart over a native library: the model compiled by souther-native-compiler, the boundaries in PHP",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ext-ffi": "*",
        "ext-pdo_sqlite": "*",
        "raoh/raoh": "^0.9",
        "souther-lang/php-runtime": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Model\\": "build/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "bin/build",
        "test": "phpunit"
    }
}
