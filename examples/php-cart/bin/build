#!/usr/bin/env bash
# Builds examples/cart-model, the model every host's cart runs, into build/native (the shared
# library) and build/php (its binding) with `souther compile --target native`. The rows of cart.sou
# run as part of the compile, and a row that does not hold refuses the build.
#
# The command is the `souther` on the PATH, or the one $SOUTHER names: a clone of
# souther-native-compiler runs this with its own stand-in (scripts/souther).
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"

"${SOUTHER:-souther}" compile --target native --library "$here/build/native" \
    --php "$here/build/php" --namespace Model "$here/../cart-model"
