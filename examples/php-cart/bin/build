#!/usr/bin/env bash
# Builds model/cart.sou into build/native (the shared library) and build/php (its binding) with the
# command line souther-native-compiler offers, run from the root of the clone this example is in.
# The rows of cart.sou run as part of the compile, and a row that does not hold refuses the build.
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
root="$(cd "$here/../.." && pwd)"

cd "$root"
mvn --batch-mode --quiet --no-snapshot-updates process-classes exec:java \
    -Dargs="--library $here/build/native --php $here/build/php --namespace Model $here/model"
