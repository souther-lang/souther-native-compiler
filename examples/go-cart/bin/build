#!/usr/bin/env bash
# Builds examples/cart-model, the model every host's cart runs, into build/native (the shared
# library) and build/go (its binding, the module example.com/go-cart/model) with `souther compile
# --target native`. The rows of cart.sou run as part of the compile, and a row that does not hold
# refuses the build before Go is reached.
#
# The command is the `souther` on the PATH, or the one $SOUTHER names: a clone of
# souther-native-compiler runs this with its own stand-in (scripts/souther).
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"

"${SOUTHER:-souther}" compile --target native --library "$here/build/native" --go "$here/build/go" \
    --package example.com/go-cart/model \
    "$here/../cart-model"
