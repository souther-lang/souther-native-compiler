<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.souther-lang</groupId>
    <artifactId>souther-native-compiler</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>Souther Native Compiler</name>
    <description>Compiles a checked Souther program to a host-native object.</description>
    <url>https://github.com/souther-lang/souther-native-compiler</url>

    <licenses>
        <license>
            <name>Eclipse Public License - v 2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kawasima</id>
            <name>kawasima</name>
            <url>https://github.com/kawasima</url>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <souther.version>0.2.1-SNAPSHOT</souther.version>
        <jspecify.version>1.0.0</jspecify.version>
        <junit.version>5.14.0</junit.version>
        <assertj.version>3.27.6</assertj.version>
        <jackson.version>3.2.2</jackson.version>
    </properties>

    <!-- A SNAPSHOT of the compiler is published here and not to Maven Central proper. -->
    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-compiler</artifactId>
            <version>${souther.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>

        <!-- A program's examples are checked by running them, so the compile a program is read
             through needs the runtime those rows call. It is also the answer a boundary's forms
             are held to, which is why a test reads it and this compiler does not. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-runtime</artifactId>
            <version>${souther.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- What a native run writes at a boundary is JSON, and a test reads it as a JSON value to
             compare it. Only as an observer: nothing here takes a rule about the external form
             from it, and the compiler never sees it. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

            <!-- Cargo builds the Rust half and Maven runs it, rather than Maven being taught to
                 build Rust. One entry point for a contributor, and one build system per language.
                 The toolchain a clone gets is the one `rust-toolchain.toml` pins, so what runs
                 here does not depend on what the machine had installed. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <workingDirectory>${project.basedir}/native</workingDirectory>
                </configuration>
                <executions>
                    <!-- Before the Java tests, because one of them reaches the driver over the
                         process boundary and a clone that had not built it would report the
                         boundary as broken. -->
                    <!-- Before the build, because what it holds is a rule about what the Rust
                         half is allowed to say, and a build that had already produced the object
                         would be reporting it after the fact. -->
                    <execution>
                        <id>cargo-lint</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <arguments>
                                <argument>clippy</argument>
                                <argument>--all-targets</argument>
                                <argument>--</argument>
                                <argument>-D</argument>
                                <argument>warnings</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-build</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <arguments>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <arguments>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
