<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.souther-lang</groupId>
    <artifactId>souther-native-parent</artifactId>
    <packaging>pom</packaging>
    <version>0.1.0-SNAPSHOT</version>

    <name>Souther Native</name>
    <description>Compiles a checked Souther program to a host-native object.</description>
    <url>https://github.com/souther-lang/souther-native-compiler</url>

    <licenses>
        <license>
            <name>Eclipse Public License - v 2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kawasima</id>
            <name>kawasima</name>
            <url>https://github.com/kawasima</url>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- What surefire reads, and what each module's exec of a test runner reads too: a build
             with -DskipTests (scripts/souther-native's) runs no tests, Rust's and Go's no more than
             Java's. A runner bound to the test phase without it ran on every command a clone ran. -->
        <skipTests>false</skipTests>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <souther.version>0.3.1-SNAPSHOT</souther.version>
        <jspecify.version>1.0.0</jspecify.version>
        <junit.version>5.14.0</junit.version>
        <assertj.version>3.27.6</assertj.version>
        <jackson.version>3.2.2</jackson.version>
        <raoh.version>0.8.0</raoh.version>
        <!-- What writes a pattern's machine as an image the runtime reads with the Rust crate of the same
             repository: the formats are notation-199x's, so the two read an image alike whichever release
             wrote it. Java's is the one Souther's compiler takes, since the two share a class path,
             and moves when Souther's does; the Rust crate is a release of its own (native/Cargo.toml). -->
        <notation199x.version>0.1.0</notation199x.version>
        <!-- What every file a jar holds is dated, so that building the same sources twice writes the same
             jar. The release embeds the checksum of each generator's jar in the compiler, and what it
             publishes has to be what it checksummed. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <!-- Whether the build is not to check that a release version carries its checksums: only the
             release workflow's first pass, which builds the generators whose checksums are to be
             written into the compiler, and throws that compiler away. -->
        <souther.skipReleaseCheck>false</souther.skipReleaseCheck>
        <!-- What the standard generators' jars say they are compatible with (BindingApi): the major of
             souther-bindings-api they are compiled against, and the ABI generations the code they write
             is for. Held to BindingApi.MAJOR and ManifestReader.ABI by the launcher's tests, which load
             the jars as the command does and are refused otherwise. -->
        <souther.bindings.api>1</souther.bindings.api>
        <souther.abi.generations>10</souther.abi.generations>
    </properties>

    <!-- Where a souther snapshot is published, for a build that takes one before its release: Central
         holds releases only. Snapshots alone are read from here, so a release resolves from Central
         as before. -->
    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <modules>
        <module>bindings/api</module>
        <module>compiler</module>
        <module>bindings/testkit</module>
        <module>bindings/php/generator</module>
        <module>bindings/rust/generator</module>
        <module>bindings/go/generator</module>
        <module>launcher</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.souther-lang</groupId>
                <artifactId>souther-compiler</artifactId>
                <version>${souther.version}</version>
            </dependency>
            <dependency>
                <groupId>org.souther-lang</groupId>
                <artifactId>souther-runtime</artifactId>
                <version>${souther.version}</version>
            </dependency>
            <dependency>
                <groupId>net.unit8.raoh</groupId>
                <artifactId>raoh</artifactId>
                <version>${raoh.version}</version>
            </dependency>
            <dependency>
                <groupId>net.unit8.raoh</groupId>
                <artifactId>raoh-json</artifactId>
                <version>${raoh.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>net.unit8.199x</groupId>
                <artifactId>199x-notation</artifactId>
                <version>${notation199x.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- What no module can do without, and none can do harm with: an annotation library, and the
         two libraries a test is written against. What a module reads of the language, of the
         compiler or of another module is declared by that module, since who can see what is the
         point of there being modules. -->
    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <!-- A test runs in its module's directory, and reaches what is not in it through the
                     root of the repository, which it is told: the Rust half, the language runtimes
                     and the driver, all of which one clone has in one place. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                    <configuration>
                        <!-- Test classes run at once, each class's tests one after another. Most of
                             a test is waiting on a C compiler, Cargo, Go or PHP it started, so one
                             class at a time left the runner's other cores idle. A class that changes
                             what the whole JVM sees, a system property or the temporary directory
                             it watches, says so with @Isolated and runs with nothing beside it. -->
                        <properties>
                            <configurationParameters>
                                junit.jupiter.execution.parallel.enabled = true
                                junit.jupiter.execution.parallel.mode.default = same_thread
                                junit.jupiter.execution.parallel.mode.classes.default = concurrent
                            </configurationParameters>
                        </properties>
                        <systemPropertyVariables>
                            <souther.repository>${maven.multiModuleProjectDirectory}</souther.repository>
                            <souther.native.driver>${maven.multiModuleProjectDirectory}/native/target/debug/souther-native-driver</souther.native.driver>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
