<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.souther-lang</groupId>
        <artifactId>souther-native-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>souther-native-compiler</artifactId>
    <name>Souther Native Compiler</name>
    <description>Compiles a checked Souther program to a host-native object, and writes a library and the bindings of it through the generators it finds.</description>

    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-compiler</artifactId>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-runtime</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- What the tests share, for the modules that test against these helpers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <!-- Before the Java tests, because one of them reaches the driver over the
                         process boundary and a clone that had not built it would report the
                         boundary as broken. -->
                    <!-- Before the build, because what it holds is a rule about what the Rust
                         half is allowed to say, and a build that had already produced the object
                         would be reporting it after the fact. -->
                    <!-- Before the lint, for the same reason: a layout is a rule about what the Rust
                         half says, and rustfmt is what states it. Checked and not applied, so a
                         build never rewrites what a contributor wrote without their seeing it. -->
                    <execution>
                        <id>cargo-format</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>fmt</argument>
                                <argument>--all</argument>
                                <argument>--check</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-lint</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>clippy</argument>
                                <argument>--all-targets</argument>
                                <argument>--</argument>
                                <argument>-D</argument>
                                <argument>warnings</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-build</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
