<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.souther-lang</groupId>
        <artifactId>souther-native-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>souther-native-compiler</artifactId>
    <name>Souther Native Compiler</name>
    <description>Compiles a checked Souther program to a host-native object, and writes a library and the bindings of it through the generators it finds.</description>

    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Classes, which walks what a type was loaded from whether the reactor hands a directory or
             a jar. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-api</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-compiler</artifactId>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-runtime</artifactId>
        </dependency>
        <!-- What writes the machine of a pattern the checker read as the image the runtime reads. -->
        <dependency>
            <groupId>net.unit8.199x</groupId>
            <artifactId>199x-notation</artifactId>
        </dependency>
        <!-- What reads the manifest the driver writes, which is this command's and no generator's. -->
        <dependency>
            <groupId>net.unit8.raoh</groupId>
            <artifactId>raoh</artifactId>
        </dependency>
        <dependency>
            <groupId>net.unit8.raoh</groupId>
            <artifactId>raoh-json</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <!-- What starts the command from a jar, and what says which release this is: the
                         version a released compiler fetches its generators and its driver at. The
                         backend jar below carries this manifest. A build from a clone is a
                         snapshot's version, which is how it knows it has no release to fetch from. -->
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>souther.nativecode.Main</mainClass>
                                    <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                    <!-- What the tests share, for the modules that test against these helpers. -->
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The descriptor `souther compile` chooses a backend by, with the Souther this is
                 built against written in: the target it answers to and that version, and nothing
                 else, since the CLI refuses any other key. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>backend-descriptor</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/backend</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/backend</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The backend: this jar and everything it runs with, as one executable jar carrying the
                 descriptor, which `souther compile` runs for the native target as a process of its own.
                 Attached beside the jar and not in its place, so that what depends on the compiler
                 as a library (the testkit) is handed its dependencies as dependencies, and the
                 descriptor is only in the jar that can run alone. Its manifest is this jar's, so
                 the release it says it is, which is what it fetches at, is the compiler's version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>backend</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>backend</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Run on the class path, where a module descriptor says
                                             nothing, and several would be one path. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>souther.nativecode.Main</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/souther-docs/sets</resource>
                                </transformer>
                                <!-- Jackson's jars each carry their license and notice at one path,
                                     and the jar keeps every one of them rather than whichever came
                                     first. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/NOTICE</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/souther/backend.properties</resource>
                                    <file>${project.build.directory}/backend/backend.properties</file>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <!-- A release version is not built without the checksums of what it fetches, which the
                         release writes into the compiler. They are not committed, so a clone rebuilding a
                         release would otherwise make a compiler that fetches nothing it can check, and
                         publish it. Its own skip, set explicitly, so that `-Dexec.skip` (which leaves out
                         Cargo) does not leave this out. -->
                    <execution>
                        <id>release-checksums</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <skip>${souther.skipReleaseCheck}</skip>
                            <mainClass>souther.nativecode.ReleaseChecksums</mainClass>
                            <arguments>
                                <argument>${project.version}</argument>
                                <argument>${project.build.outputDirectory}/souther/nativecode/release-checksums.properties</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Before the Java tests, because one of them reaches the driver over the
                         process boundary and a clone that had not built it would report the
                         boundary as broken. -->
                    <!-- Before the build, because what it holds is a rule about what the Rust
                         half is allowed to say, and a build that had already produced the object
                         would be reporting it after the fact. -->
                    <!-- Before the lint, for the same reason: a layout is a rule about what the Rust
                         half says, and rustfmt is what states it. Checked and not applied, so a
                         build never rewrites what a contributor wrote without their seeing it. -->
                    <execution>
                        <id>cargo-format</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>fmt</argument>
                                <argument>--all</argument>
                                <argument>--check</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-lint</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>clippy</argument>
                                <argument>--all-targets</argument>
                                <argument>--</argument>
                                <argument>-D</argument>
                                <argument>warnings</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-build</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cargo-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>cargo</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/native</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
