<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.souther-lang</groupId>
        <artifactId>souther-native-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>souther-native-launcher</artifactId>
    <name>Souther Native Launcher</name>
    <description>The command as a clone runs it: the compiler, handed the jars of the PHP, the Rust and the Go generator this build made, which it loads as it loads any generator's jar. Not published.</description>

    <properties>
        <!-- What the release publishes is what a user of the compiler fetches, and a launcher is what a
             clone runs the command with. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <!-- The generators are built before this and are not on its class path: provided, so that the
         reactor builds their jars first and the runtime class path the command runs with leaves them
         out. The command is handed each jar by -Dsouther.generator.<id> (scripts/souther-native, and
         the tests below), and loads it as it loads any generator's jar, behind its own loader. -->
    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-native-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-binding-php</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-binding-rust</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-binding-go</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <souther.generator.php>${maven.multiModuleProjectDirectory}/bindings/php/generator/target/souther-binding-php-${project.version}.jar</souther.generator.php>
                        <souther.generator.rust>${maven.multiModuleProjectDirectory}/bindings/rust/generator/target/souther-binding-rust-${project.version}.jar</souther.generator.rust>
                        <souther.generator.go>${maven.multiModuleProjectDirectory}/bindings/go/generator/target/souther-binding-go-${project.version}.jar</souther.generator.go>
                        <!-- The backend jar the compiler's module attaches, which a test runs as the CLI
                             runs it, and the version it is to say it is. -->
                        <souther.backend.jar>${maven.multiModuleProjectDirectory}/compiler/target/souther-native-compiler-${project.version}-backend.jar</souther.backend.jar>
                        <souther.native.version>${project.version}</souther.native.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- What the command runs with, written down for `scripts/souther-native`: the compiler as
                 this build has it, and what it needs, and no generator. A launcher that is a set of
                 dependencies has nothing to package, and the command is run from where the modules
                 are built rather than from an installed copy of them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>runtime-classpath</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                    <!-- And the jars of the generators, which the command is handed and not given on
                         its class path. -->
                    <execution>
                        <id>generators</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>provided</includeScope>
                            <includeGroupIds>org.souther-lang</includeGroupIds>
                            <outputFile>${project.build.directory}/generators.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
