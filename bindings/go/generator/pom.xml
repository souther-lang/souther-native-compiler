<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.souther-lang</groupId>
        <artifactId>souther-native-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>souther-binding-go</artifactId>
    <name>Souther Go Binding</name>
    <description>Writes the Go binding of a library from its manifest.</description>

    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-api</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- What a test builds its library with, as a generator of someone else's is tested. -->
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-native-compiler</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-native-compiler</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- What the runtime module says of itself, its path and its version, which the packages
                 are written against: copied in, so that it is stated only there. -->
            <resource>
                <directory>${project.basedir}/../runtime</directory>
                <includes>
                    <include>go.mod</include>
                    <include>VERSION</include>
                </includes>
                <targetPath>souther/bindings/go/runtime</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- Which generator the jar is and what it is compatible with, read by the command before
                 any of the jar's code runs (souther.bindings.BindingApi). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Souther-Binding-Id>go</Souther-Binding-Id>
                            <Souther-Binding-Api>${souther.bindings.api}</Souther-Binding-Api>
                            <Souther-Abi-Generations>${souther.abi.generations}</Souther-Abi-Generations>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <!-- The Go that is installed, and never another that Go would fetch on its own. -->
                    <environmentVariables>
                        <GOTOOLCHAIN>local</GOTOOLCHAIN>
                    </environmentVariables>
                </configuration>
                <executions>
                    <!-- The Go runtime every Go binding runs on: a module of its own and not a part
                         of this one, since a host builds it and not this project. Held to gofmt, to
                         go vet, and to its tests under the race detector, which is what holds a
                         run to its goroutine. -->
                    <execution>
                        <id>go-runtime-format</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/bindings/go/runtime</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>test -z "$(gofmt -l .)"</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>go-runtime-vet</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>go</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/bindings/go/runtime</workingDirectory>
                            <arguments>
                                <argument>vet</argument>
                                <argument>./...</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>go-runtime-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>go</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/bindings/go/runtime</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                                <argument>-race</argument>
                                <argument>-count=1</argument>
                                <argument>./...</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
