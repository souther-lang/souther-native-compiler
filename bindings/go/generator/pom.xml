<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.souther-lang</groupId>
        <artifactId>souther-native-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>souther-binding-go</artifactId>
    <name>Souther Go Binding</name>
    <description>Writes the Go binding of a library from its manifest.</description>

    <dependencies>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-bindings-api</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-native-compiler</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.souther-lang</groupId>
            <artifactId>souther-native-compiler</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- What says which release this generator is, which the packages it writes require the
                 runtime module of. A build from a clone has no release, and the entry says so. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <!-- The Go runtime every Go binding runs on: a module of its own and not a part
                         of this one, since a host builds it and not this project. Held to gofmt, to
                         go vet, and to its tests under the race detector, which is what holds a
                         run to its goroutine. -->
                    <execution>
                        <id>go-runtime-format</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/bindings/go/runtime</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>test -z "$(gofmt -l .)"</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>go-runtime-vet</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>go</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/bindings/go/runtime</workingDirectory>
                            <arguments>
                                <argument>vet</argument>
                                <argument>./...</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>go-runtime-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>go</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/bindings/go/runtime</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                                <argument>-race</argument>
                                <argument>-count=1</argument>
                                <argument>./...</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
